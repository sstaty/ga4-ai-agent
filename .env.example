ANTHROPIC_API_KEY=
# Accepts either:
#   - A service account key JSON (from Google Cloud Console -> Service Accounts)
#   - An OAuth2 token in ADC authorized_user format (run: uv run python scripts/setup_oauth.py)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials-or-oauth_token.json
# Required: your GA4 property ID (digits only, e.g. 123456789). Must be set before use.
GA4_PROPERTY_ID=

# Langfuse observability (optional — leave blank to disable tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
